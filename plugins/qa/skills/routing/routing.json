{
  "items": [
    {
      "kind": "github",
      "label": "GitHub issue",
      "pattern": "(?<![\\w&/])#\\d+\\b",
      "route": "lead.github"
    },
    {
      "kind": "azure",
      "label": "Azure DevOps work item",
      "pattern": "\\bAB#\\d+\\b"
    },
    {
      "kind": "request",
      "label": "work item with no tracker",
      "pattern": "\\bREQ-\\d+\\b"
    },
    {
      "kind": "risk",
      "label": "risk from the register",
      "pattern": "\\bR-(?:[A-Za-z0-9]+-)+\\d+\\b",
      "route": "lead.manual"
    },
    {
      "kind": "jira",
      "label": "Jira issue",
      "pattern": "\\b(?!REQ-|TC-|AB-)[A-Z][A-Z0-9]+-\\d+\\b(?!-)"
    }
  ],
  "routes": [
    {
      "id": "lead.github",
      "agent": "qa-lead",
      "skill": "qa:intake-github",
      "signals": [
        "github issue",
        "this issue",
        "the issue",
        "through testing",
        "take it through",
        "up to the completion report",
        "up to the report"
      ]
    },
    {
      "id": "lead.manual",
      "agent": "qa-lead",
      "skill": "qa:intake-manual",
      "signals": [
        "no ticket",
        "there's no ticket",
        "not in a tracker",
