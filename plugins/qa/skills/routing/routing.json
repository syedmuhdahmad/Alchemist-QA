  "depth": {
    "low": {
      "techniques": [
        "equivalence-partitioning"
      ],
      "review": "none",
      "devices": "Smoke: one browser and one Android phone"
    },
    "medium": {
      "techniques": [
        "equivalence-partitioning",
        "boundary-value",
        "decision-table",
        "error-guessing"
      ],
      "review": "sampled",
      "devices": "Regression: a phone and a tablet"
    },
    "high": {
      "techniques": [
        "equivalence-partitioning",
        "boundary-value",
        "decision-table",
        "error-guessing",
        "state-transition",
        "exploratory"
      ],
      "review": "all",
      "devices": "Full portfolio: browsers, Android, iOS, tablets, and the non-functional packs"
    }
  }
}
