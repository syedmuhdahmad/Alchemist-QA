{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qa/trace.json",
  "description": "Traceability from work item to risk to test case to test to result (CTFL 1.4.4).",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_item", "risks", "cases"],
        "additionalProperties": false,
        "properties": {
          "work_item": { "type": "string" },
          "risks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "level"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "level": { "enum": ["low", "medium", "high"] }
              }
            }
          },
          "assumptions": {
            "description": "The assumptions of the item's basis review, with the owner's answer so far.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^A[0-9]+$" },
                "status": { "enum": ["open", "confirmed", "corrected"] }
              }
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "technique", "tests"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "technique": { "type": "string" },
                "risk": { "type": "string" },
                "rests_on": {
                  "description": "The assumptions the case's expected result comes from: the A<n> ids in its Basis column.",
                  "type": "array",
                  "items": { "type": "string", "pattern": "^A[0-9]+$" }
                },
                "not_automated": { "description": "Why this case has no test.", "type": "string" },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path", "result"],
                    "additionalProperties": false,
                    "properties": {
                      "path": { "type": "string" },
                      "result": { "enum": ["passed", "failed", "blocked", "not-run"] },
                      "defect": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
