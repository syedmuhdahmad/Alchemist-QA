{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipelines.yaml",
  "description": "Ordered stages that hooks carry work through. A stage is done when its exit criteria hold on disk (CTFL 5.1.3).",
  "type": "object",
  "required": ["pipelines"],
  "additionalProperties": false,
  "properties": {
    "pipelines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["stages"],
        "additionalProperties": false,
        "properties": {
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "exit"],
              "additionalProperties": false,
              "oneOf": [{ "required": ["agent"] }, { "required": ["parallel"] }],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "agent": { "type": "string" },
                "method": { "type": "string" },
                "parallel": { "type": "array", "minItems": 2, "items": { "type": "string" } },
                "when": { "type": "string" },
                "exit": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
