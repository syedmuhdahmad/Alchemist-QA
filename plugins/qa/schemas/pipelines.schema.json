{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipelines.yaml",
  "description": "Ordered stages that hooks carry work through. A stage is done when its exit criteria hold on disk (CTFL 5.1.3).",
  "type": "object",
  "required": ["pipelines"],
  "additionalProperties": false,
  "properties": {
    "pipelines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["stages"],
        "additionalProperties": false,
        "properties": {
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "agent", "exit"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "agent": { "type": "string" },
                "method": { "type": "string" },
                "parallel": { "description": "One agent per capability in qa/profile.yaml, at once.", "type": "boolean" },
                "when": { "description": "The stage runs only when this holds.", "enum": ["risk >= medium"] },
                "exit": {
                  "description": "Named checks in the pipeline skill's checks.mjs, all of which must hold on disk.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": ["basis", "review-not-blocked", "register-section", "cases", "plan-exit-criteria", "cases-automated", "failures-classed", "review-recorded", "report-verdict"]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
