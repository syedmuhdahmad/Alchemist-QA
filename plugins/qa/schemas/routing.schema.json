{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "routing.yaml",
  "description": "Maps a request to the agent and method skill that handle it. Single source for the lead's routing table, the intake matcher, and the routing tests.",
  "type": "object",
  "required": ["routes"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "description": "Work-item ids the matcher recognises. An item with a route picks it when no signal matches.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "label", "pattern"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z]+$" },
          "label": { "type": "string", "minLength": 1 },
          "pattern": { "description": "A JavaScript regular expression, applied case-sensitively.", "type": "string", "minLength": 1 },
          "route": { "type": "string" }
        }
      }
    },
    "depth": {
      "description": "How deeply to test at each risk level (CTFL 5.2): techniques, testware review, and devices.",
      "type": "object",
      "required": ["low", "medium", "high"],
      "additionalProperties": false,
      "patternProperties": {
        "^(low|medium|high)$": {
          "type": "object",
          "required": ["techniques", "review", "devices"],
          "additionalProperties": false,
          "properties": {
            "techniques": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "review": { "enum": ["none", "sampled", "all"] },
            "devices": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "activity", "signals", "agent", "method"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$" },
          "activity": {
            "description": "ISTQB test activity (CTFL 1.4.1).",
            "enum": ["planning", "monitoring", "analysis", "design", "implementation", "execution", "completion"]
          },
          "level": { "enum": ["component", "integration", "system", "acceptance"] },
          "signals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
          "agent": { "type": "string" },
          "method": { "type": "string" },
          "capability": { "$ref": "profile.schema.json#/$defs/capability" },
          "writes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
